# Application Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/planora_db"

# JWT Secret Configuration
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN=7d

# Google OAuth Client ID must match FE VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Configuration (Optional: default is 'none')
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# SMTP email configuration for real forgot-password OTP delivery
# Gmail example: create an App Password in Google Account, then use smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Planora <your_email@gmail.com>"
