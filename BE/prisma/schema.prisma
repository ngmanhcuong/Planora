datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CategoryType {
  STUDY
  WORK
  TASK
  MEETING
  PERSONAL
  HABIT
  DEADLINE
}

enum ClassType {
  THEORY
  PRACTICE
  EXAM
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum Language {
  VI
  EN
  JA
  KO
  ZH
  FR
  DE
  ES
}

enum NotificationType {
  SYSTEM
  DEADLINE
  TIMETABLE
  HABIT
  EVENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       Profile?
  settings      UserSetting?
  categories    Category[]
  tasks         Task[]
  events        Event[]
  timetables    Timetable[]
  habits        Habit[]
  notifications Notification[]

  @@index([email])
  @@map("users")
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  studentId        String?
  major            String?
  university       String?
  gpa              Float    @default(0.0)
  completedCredits Int      @default(0)
  totalCredits     Int      @default(135)
  bio              String?  @db.Text
  avatarUrl        String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSetting {
  id                    String    @id @default(cuid())
  userId                String    @unique
  theme                 ThemeMode @default(LIGHT)
  language              Language  @default(VI)
  emailNotifications    Boolean   @default(true)
  pushNotifications     Boolean   @default(true)
  deadlineReminderHours Int       @default(24)
  timetableAlerts       Boolean   @default(true)
  soundEffects          Boolean   @default(false)
  twoFactorAuth         Boolean   @default(false)
  loginAlerts           Boolean   @default(true)
  autoSaveDrafts        Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Category {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  type      CategoryType
  color     String       @default("#4F46E5")
  bgColor   String       @default("#E2DFFF")
  textColor String       @default("#3323CC")
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  events Event[]
  habits Habit[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Task {
  id                     String       @id @default(cuid())
  userId                 String
  categoryId             String?
  title                  String
  description            String?      @db.Text
  status                 TaskStatus   @default(TODO)
  priority               TaskPriority @default(MEDIUM)
  dueDate                DateTime
  dueTime                String?
  courseCode             String?
  subtasksCountTotal     Int          @default(0)
  subtasksCountCompleted Int          @default(0)
  completedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

model Event {
  id                 String         @id @default(cuid())
  userId             String
  categoryId         String?
  title              String
  description        String?        @db.Text
  location           String?
  startTime          DateTime
  endTime            DateTime
  isAllDay           Boolean        @default(false)
  hasConflict        Boolean        @default(false)
  recurrenceType     RecurrenceType @default(NONE)
  recurrenceInterval Int            @default(1)
  recurrenceEndDate  DateTime?
  color              String         @default("#4F46E5")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startTime, endTime])
  @@map("events")
}

model Timetable {
  id            String   @id @default(cuid())
  userId        String
  termName      String
  academicYear  String
  totalCredits  Int      @default(0)
  totalSubjects Int      @default(0)
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items TimetableItem[]

  @@index([userId])
  @@map("timetables")
}

model TimetableItem {
  id          String    @id @default(cuid())
  timetableId String
  subjectName String
  courseCode  String
  dayOfWeek   Int // 0 = Monday ... 6 = Sunday
  startSlot   Int // 1 to 10
  slotSpan    Int // 1 to 4
  startTime   String // e.g. "07:00"
  endTime     String // e.g. "09:30"
  timeRange   String
  room        String
  lecturer    String
  type        ClassType @default(THEORY)
  color       String    @default("#0058BE")
  bgColor     String    @default("#D8E2FF")
  textColor   String    @default("#001A42")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([timetableId])
  @@index([timetableId, dayOfWeek])
  @@map("timetable_items")
}

model Habit {
  id                String    @id @default(cuid())
  userId            String
  categoryId        String?
  title             String
  description       String?   @db.Text
  targetFrequency   Int       @default(7) // Days per week
  currentStreak     Int       @default(0)
  bestStreak        Int       @default(0)
  lastCompletedDate DateTime? @db.Date
  color             String    @default("#006E4B")
  icon              String    @default("flame")
  isCompletedToday  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logs     HabitLog[]

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id            String   @id @default(cuid())
  habitId       String
  completedDate DateTime @db.Date
  isCompleted   Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedDate])
  @@index([habitId])
  @@map("habit_logs")
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  title             String
  message           String           @db.Text
  type              NotificationType @default(SYSTEM)
  relatedEntityType String? // e.g. "TASK", "EVENT", "TIMETABLE", "HABIT"
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  link              String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}
